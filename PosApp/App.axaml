<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PosApp.App"
             RequestedThemeVariant="Light">

  <Application.Styles>
    <!-- Fluent theme with the POS green (#027342) as the accent colour -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#027342" RegionColor="White" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="/Styles/Theme.axaml" />
  </Application.Styles>

</Application>
